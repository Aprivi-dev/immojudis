# Supabase (public, inlined at build time). The NEXT_PUBLIC_* names are canonical.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# DEPRECATED: VITE_SUPABASE_* are only read as a fallback of the NEXT_PUBLIC_* names (see
# src/lib/env.ts and next.config.ts). Leave them unset in a new environment; remove them from
# Vercel once the NEXT_PUBLIC_* variables are deployed.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin. SITE_URL is the canonical name; the aliases NEXT_PUBLIC_SITE_URL,
# NEXT_PUBLIC_APP_URL and APP_URL remain accepted as fallbacks; VERCEL_URL only outside production (src/lib/site-url.ts).
SITE_URL=http://localhost:3000

# Search-engine indexing switch. CLOSED unless the value is exactly "true": absent, empty or any
# other value sends `X-Robots-Tag: noindex, nofollow` on every response (src/proxy.ts) and a
# robots.txt without sitemap. Read on each request (not frozen at build). A Vercel preview or
# development deployment stays closed even with "true". Open it only on launch day, see
# docs/vercel_setup.md ("Indexation et référencement").
SEO_INDEXING_ENABLED=false
# The production smoke test (scripts/check-production-smoke.mjs) reads this same name to know which
# state to expect: keep the GitHub repository variable SEO_INDEXING_ENABLED equal to the Vercel one.

# Strict nonce-based CSP (P4-04). By default it is NOT sent: the historical CSP alone is enforced
# (the static pages carry no nonce, so a report-only strict policy flagged ~35 scripts per visit).
# false = enforce the strict policy (forces dynamic rendering of every page, no ISR / CDN cache).
# Flipping CSP_REPORT_ONLY or CSP_NONCE_DYNAMIC takes a FULL REDEPLOY, not just a changed variable:
# next.config.ts reads them at build time (headers, the pages' static or dynamic rendering) and the
# CDN keeps serving the pages and ISR entries built under the previous value until then.
CSP_REPORT_ONLY=true
# Preview the strict policy in report-only mode (via /api/csp-report) and the dynamic-rendering
# cost of nonces. Only with CSP_REPORT_ONLY=true.
CSP_NONCE_DYNAMIC=false
# Extra https origins allowed in frame-src (document viewer hosts), space separated.
CSP_FRAME_SRC_EXTRA=

# Administrator MFA (P0-02). Keep false until a TOTP factor is enrolled at /admin/securite, then set
# true here AND run `select app_private.set_admin_mfa_required(true);` in the database.
ADMIN_MFA_REQUIRED=false

# Mapbox powers interactive maps and static listing thumbnails.
# Example style: mapbox/streets-v12 or mapbox://styles/<user>/<style>
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12
# Repli de NEXT_PUBLIC_MAPBOX_STYLE (lu seulement si ce dernier est absent) ; défaut mapbox/streets-v12.
# NEXT_PUBLIC_MAPBOX_STYLE_ID=

# Test d'hébergement des photos principales (bucket public `sale-photos`, fonction `sale_photo_mirrors`).
# `on` : le site affiche notre copie de la photo, avec repli sur la source. Absent ou autre : photos
# des sources comme avant. Inlined at build time. Le pipeline a son propre interrupteur (PHOTO_MIRROR_ENABLED).
NEXT_PUBLIC_PHOTO_MIRROR=

# Server-side variables used only by trusted server routes/middleware.
# Do not expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=

# Server-side kill switch. Keep false until reviewed A/B snapshots are available.
TRIBUNAL_STATISTICS_ENABLED=false

# Server-side gate for the adjudication-price statistics and the auction scenarios shown on the sale
# page and on /tribunaux. Closed by default; set true only where the published data is meant to be shown.
ADJUDICATION_PRICE_STATISTICS_ENABLED=false
# Optional: pin the published adjudication-price build to display (UUID). Empty = the reviewed build published in the database.
ADJUDICATION_PRICE_STATISTICS_BUILD_ID=

# Server-side switch per fee regime for the bid ceiling (sale page, saved report and its PDF):
# comma-separated regime keys among tribunal, notary_auction (notarial sale by candle) and
# notary_online (notarial interactive sale, by offers). The tribunal regime is always open; a key whose
# rules are not defined (state_auction) opens nothing.
#   - Variable ABSENT (line commented out, the default): every defined regime is open, so the ceiling
#     is offered for the tribunal, the notarial candle sales and the notarial interactive sales.
#   - Variable PRESENT, even empty: only the listed regimes are open. CEILING_FEE_REGIMES_OPEN=tribunal
#     closes the notarial regimes (kill switch); an empty value does the same.
#   Read through src/lib/env.ts, which (unlike the other variables) keeps "absent" and "empty" apart.
# CEILING_FEE_REGIMES_OPEN=notary_auction,notary_online

# Base silencieuse du changement de loyers (carte des loyers de l'ANIL) pour les alertes à rendement
# minimal. À poser UNIQUEMENT lors d'un changement de la base de loyers, en date ISO UTC de l'IMPORT de
# anil_rents (c'est lui qui change les loyers lus, pas le déploiement du code), avant le premier passage
# de smart-alerts qui suit (06:15 UTC) ; redéployer. Pendant les 48 heures qui suivent, la première
# évaluation de chaque alerte enregistre les correspondances dues aux seuls nouveaux loyers SANS
# notification. Absente (défaut) ou invalide : aucune base silencieuse, sans message. La RETIRER ensuite.
# Voir docs/runbooks/import-annuel-anil.md. Valeur posée en production : 2026-10-27T00:10:00Z, à retirer
# après le 29/10/2026 à 00:10 UTC.
# ALERT_RENT_BASIS_SWITCH_AT=<date ISO UTC de l'import>

# Opens the public page /prix-encheres-immobilieres (real adjudication prices, free access).
# Closed by default: 404, noindex, absent from sitemap.xml. It also requires
# ADJUDICATION_PRICE_STATISTICS_ENABLED=true above (cutting that one closes this page too), and
# each value must be exactly "true". Open it only with Licitor's written agreement and the legal
# review (see docs/vercel_setup.md, "Pages publiques de prix d'adjudication").
PUBLIC_ADJUDICATION_PRICES_ENABLED=false

# Server/worker-only StatJur network and persistence gate. Keep false until legal review.
JUSTICE_ACTIVITY_ENABLED=false

# Server/worker-only evaluation persistence gate. Never expose to browser code.
OUTCOME_EVALUATION_ENABLED=false

# Optional build cache, only on a filesystem without synchronization conflicts.
IMMOJUDIS_BUILD_CACHE=false
# Optional isolated output directory, relative to this project. Default: .next
IMMOJUDIS_NEXT_DIST_DIR=

# Optional: Stripe Billing for the Analyse subscription.
# Configure these in Vercel/server envs before activating paid checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Approved recurring Stripe Price for Analyse. Checkout stays disabled when empty.
STRIPE_ANALYSIS_PRICE_ID=
# Optional: former Analyse Prices (comma separated) still billed to existing subscribers. A
# subscription on a Price listed neither here nor above loses its access, so list the old Price
# BEFORE switching STRIPE_ANALYSIS_PRICE_ID. New checkouts only use STRIPE_ANALYSIS_PRICE_ID.
STRIPE_ANALYSIS_LEGACY_PRICE_IDS=
# Public copy for the approved local offer. Keep it aligned with the Stripe Price (59 EUR/month).
# The label must state "TTC" (prices are shown to consumers): a label without it is ignored and the
# approved "59 € TTC / mois" is shown instead.
NEXT_PUBLIC_ANALYSIS_OFFER_LABEL="59 € TTC / mois"

# Public legal identity. Required before enabling paid checkout and, by law, for any public site.
# Set REQUIRE_LEGAL_IDENTITY=true once these values exist: the production check then fails without them.
REQUIRE_LEGAL_IDENTITY=false
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_FORM=
NEXT_PUBLIC_LEGAL_ENTITY_CAPITAL=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_MEDIATOR_NAME=
NEXT_PUBLIC_LEGAL_MEDIATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_MEDIATOR_WEBSITE=

# Optional: Vercel Cron security and smart-alert batch sizing.
# Vercel sends Authorization: Bearer $CRON_SECRET to configured cron routes.
CRON_SECRET=
# Secret dédié au rappel du pipeline POST /api/pipeline/revalidate-sale (le pipeline expire le cache d'une
# vente publique avec lui). TRANSITION : tant qu'il est absent, CRON_SECRET reste accepté pour cette route (et
# un avertissement est journalisé) ; dès qu'il est posé, il est le seul accepté et CRON_SECRET ne l'ouvre plus.
# À poser en même temps côté Vercel et comme secret GitHub PIPELINE_CALLBACK_SECRET une fois le pipeline mis à jour.
# PIPELINE_CALLBACK_SECRET=
# Plafond de ventes chargées par compte à chaque évaluation des alertes (défaut 6000, maximum 20000).
# Le lot évalue tous les comptes qui ont une alerte active : il n'existe pas de plafond de comptes.
# SMART_ALERT_CRON_SALE_LIMIT=6000
ALERT_NOTIFICATION_CRON_LIMIT=200
# Lot tourné des comptes sans consentement aux rappels ; ceux qui ont consenti sont tous examinés
# chaque jour, en plus.
SALE_CHANGE_CRON_USER_LIMIT=25

# Interrupteur d'envoi des alertes par email (emails des alertes enregistrées). Variable ABSENTE : `on`, comme
# avant. off : aucun email d'alerte ne part, ils restent en file (les notifications dans l'application
# continuent) ; internal : seulement aux administrateurs ; on : à toutes les personnes ayant consenti. Une valeur
# inconnue vaut off. Voir docs/runbooks/emails-envoyes-a-tort.md.
# ALERT_NOTIFICATIONS_MODE=on

# Rappels d'audience (J-7, J-1) et avertissements graves par email sur les ventes suivies.
# off (défaut, ou toute autre valeur) : rien n'est envoyé et la case de consentement n'est pas
# proposée ; internal : seulement aux administrateurs ayant consenti (mesure des fausses alertes) ;
# on : toutes les personnes ayant consenti. Voir docs/operations/planification.md.
# SALE_REMINDERS_MODE=off

# Règle des pépites « pepite-v2 » (critère éliminatoire du risque d'inondation). FERMÉE par défaut : variable
# absente ou autre chose que true / 1, la règle appliquée reste pepite-v1.1 (le traitement des pépites ne lit pas
# la table d'inondation, aucun résultat ne change) pendant que /api/cron/sale-flood-risk s'alimente et se calibre.
# La bascule est un seul geste : PEPITE_RULE_V2_ENABLED=true, puis redéploiement ; le retour arrière est le même
# geste inverse. Voir docs/operations/planification.md.
# PEPITE_RULE_V2_ENABLED=false

# Taille du lot du traitement d'inondation (ventes observées par passage horaire, 150 par défaut ; 2 à 3 appels
# par seconde aux services de l'État). Voir docs/operations/planification.md. Depuis le 27/10/2026 les appels
# partent de GitHub Actions (workflow sale-flood-risk.yml) : la taille de lot qui compte est alors la variable
# de dépôt GitHub du même nom.
# SALE_FLOOD_RISK_BATCH_LIMIT=150

# D'où partent les appels du traitement d'inondation. Défaut (absente) : la route déclenche le workflow GitHub
# sale-flood-risk.yml, Géorisques refusant les appels de Vercel. « vercel » : retour arrière, la route fait les
# appels elle-même. Voir docs/runbooks/georisques-pannes-inondation.md.
# SALE_FLOOD_RISK_RUNNER=vercel

# Tailles de lot des autres traitements planifiés (valeurs par défaut du code ; maximum 2000, et 100 pour le
# pré-calcul des valorisations). Variables facultatives.
# SALE_PEPITES_BATCH_LIMIT=300
# LISTING_COMPLETENESS_BATCH_LIMIT=300
# VALUATION_PRECOMPUTE_BATCH_LIMIT=75

# Jeton de l'API Géorisques v2 pour le dossier foncier (facultatif). Présent : le dossier utilise l'API v2 et sa
# couche TRI y reste « non vérifiée ». Le contrôle d'inondation des pépites appelle toujours l'API v1, sans jeton.
# GEORISQUES_API_TOKEN=

# Sel de l'empreinte d'adresse IP des limites de débit (facultatif ; sans valeur, un sel fixe du code est utilisé).
# Le changer remet à zéro les compteurs par adresse.
# RATE_LIMIT_IP_SALT=

# Récapitulatif hebdomadaire « Ma semaine » par email (un par semaine, au jour choisi par le compte).
# Même logique que SALE_REMINDERS_MODE : off (défaut, ou toute autre valeur) : rien n'est envoyé et la
# case de consentement n'est pas proposée ; internal : administrateurs seulement ; on : toutes les
# personnes ayant consenti. À n'ouvrir qu'après mise à jour de la politique de confidentialité et du
# registre des traitements. Voir docs/operations/planification.md.
# WEEKLY_DIGEST_MODE=off

# Alerte de résultat ou de remise en vente d'une vente suivie par email (jamais de prix dans l'email).
# Mêmes valeurs et mêmes conditions d'ouverture que WEEKLY_DIGEST_MODE.
# SALE_RESULTS_MODE=off

# Email unique de fin d'essai gratuit (J+5 après la confirmation de l'adresse) : ce qui reste gratuit,
# ce qui se ferme, rien ne devient payant, lien de désinscription en un clic. off (défaut, ou toute autre
# valeur) : rien n'est envoyé ; internal : un message d'exemple « [Test interne] » aux administrateurs
# seulement ; on : aux comptes dont l'essai se termine dans deux jours. À n'ouvrir qu'après relecture du
# texte et du registre des traitements (juridique-rgpd). Voir docs/operations/planification.md.
# TRIAL_END_EMAIL_MODE=off

# Résumé quotidien « N réponses à relire » (réponses de l'agent d'information en relecture et messages
# reçus à l'adresse de réponse sans dossier ouvert), envoyé à OPERATIONS_ALERT_EMAIL_TO (ci-dessous) à
# 07:05 UTC. Jamais le corps d'un message, jamais un envoi à l'expéditeur. off (défaut, ou toute autre
# valeur) : rien n'est lu ni envoyé ; preview : les nombres sont rendus dans le compte rendu du passage
# sans email ; on : l'email part, seulement s'il y a quelque chose à relire. Voir
# docs/operations/planification.md.
# REPLIES_REVIEW_DIGEST_MODE=off

# Date-only auction listings leave the public catalogue after the Paris civil day.
# Supported values: end_of_local_day (default) or start_of_day.
IMMOJUDIS_DATE_ONLY_CATALOGUE_POLICY=end_of_local_day

# Operational incidents use the existing GitHub Actions token by default.
# A dedicated HTTPS webhook takes precedence when configured.
GITHUB_SCROLL_TOKEN=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=
OPERATIONS_ALERT_GITHUB_REPOSITORY=Aprivi-dev/immojudis
OPERATIONS_ALERT_GITHUB_WORKFLOW=operational-alert.yml
OPERATIONS_ALERT_GITHUB_REF=main
OPERATIONS_ALERT_DELIVERY_LIMIT=10
# Optional second channel: an email to the owner (comma separated, three addresses at most) for every
# incident opened, still open or resolved, in addition to the channel above. Sent with Resend, so it also
# needs RESEND_API_KEY and ALERT_EMAIL_FROM below. Empty: no incident email.
OPERATIONS_ALERT_EMAIL_TO=

# Optional: Resend transactional email delivery for smart alerts and lawyer referrals.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Secret de signature (whsec_…) du second webhook Resend, /api/webhooks/resend/account-emails, abonné à
# email.bounced et email.complained : un rebond définitif ou une plainte retire le consentement email du compte.
# Chaque webhook Resend a son propre secret. Voir docs/runbooks/rebonds-plaintes-emails.md.
RESEND_ACCOUNT_WEBHOOK_SECRET=
ALERT_EMAIL_FROM="Immojudis <alertes@immojudis.com>"
# Expéditeur « ne pas répondre » des emails automatiques : alertes, récapitulatif « Ma semaine », rappels
# d'audience, alertes de résultat, fin d'essai, ouverture de l'offre (et, dans Supabase, les emails
# d'authentification, réglés par scripts/apply-supabase-auth-config.mjs). Ces emails n'ont AUCUN reply-to et
# portent la mention « Message automatique, merci de ne pas y répondre ». Absent : ALERT_EMAIL_FROM.
# Exemple : NOREPLY_EMAIL_FROM="Immojudis <ne-pas-repondre@immojudis.com>"
NOREPLY_EMAIL_FROM=
# Expéditeur des messages qui acceptent une réponse : paiement échoué, résiliation, confirmation de commande,
# mise en relation avec un avocat. Ils gardent le reply-to ci-dessous. Absent : ALERT_EMAIL_FROM.
# Exemple : TRANSACTIONAL_EMAIL_FROM="Immojudis <contact@immojudis.com>"
TRANSACTIONAL_EMAIL_FROM=
# Adresse de réponse des emails qui acceptent une réponse (facturation, mise en relation) : à défaut,
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL. Sans l'une ni l'autre, aucun reply-to. Les emails « ne pas répondre »
# n'en ont jamais.
EMAIL_REPLY_TO=
# P4-12 : expéditeur des demandes de l'agent d'information. Le nom affiché est « Immojudis » (comme la
# marque), l'adresse est celle du domaine déjà vérifié en envoi ET en réception, reponses.immojudis.com :
# elle est distincte des emails de compte (alertes@, compte@ : confirmation d'inscription, mot de passe),
# donc un rebond ou une plainte sur un email de compte n'est jamais pris pour un évènement de l'agent
# (src/lib/information-agent-inbound/delivery-events.ts compare cette adresse). Garder l'interrupteur
# ci-dessous à false tant qu'un avocat n'a pas validé le modèle ; le pied demande
# NEXT_PUBLIC_LEGAL_ENTITY_NAME/ADDRESS et le secret du portail.
INFORMATION_AGENT_EMAIL_FROM="Immojudis <enquete@reponses.immojudis.com>"

# Formulaire de contact (Resend). Destinataire : CONTACT_EMAIL_TO, à défaut NEXT_PUBLIC_LEGAL_CONTACT_EMAIL.
# Expéditeur : CONTACT_EMAIL_FROM seulement (aucun repli sur ALERT_EMAIL_FROM). Sans RESEND_API_KEY, le formulaire
# affiche qu'il est indisponible.
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
# Plafond de validations par administrateur et par jour de Paris (entier positif ; défaut 30).
# INFORMATION_AGENT_ADMIN_DAILY_APPROVAL_CAP=30
# Contrôle des adresses (longueur, artefacts, domaines réservés, MX/A, rebonds passagers). Ne JAMAIS mettre
# « off » en production : réservé aux essais automatisés.
# INFORMATION_AGENT_ADDRESS_CHECK=
# Domaine de réception Resend, sans protocole (ex. reponses.immojudis.com).
INFORMATION_AGENT_INBOUND_DOMAIN=reponses.immojudis.com
# Secret aléatoire d'au moins 32 octets pour signer les liens privés de dépôt.
INFORMATION_AGENT_PORTAL_SECRET=
# Maintenir false jusqu'à autorisation explicite d'envoyer à de vrais contacts. Même à true, chaque
# e-mail reste déclenché à la main par un administrateur, fiche par fiche, après l'aperçu.
INFORMATION_AGENT_OUTBOUND_ENABLED=false
INFORMATION_AGENT_OUTBOUND_CANARY_ONLY=true
# Recherche automatique de l'adresse du professionnel (autre annonce, site du cabinet). Coupée sauf
# valeur exactement "true", et seulement sur https://immojudis.com. Ne l'activer qu'après les
# conditions du runbook (docs/runbooks/information-agent.md).
INFORMATION_AGENT_ADDRESS_SEARCH_ENABLED=false
# Greffe de secours : plafond de demandes aux greffes par tribunal et par jour (heure de Paris), pour les
# ventes au tribunal sans aucun avocat ni cabinet exploitable (docs/runbooks/information-agent.md).
# Entier de 0 à 100 ; 0 : aucune demande aux greffes ; absente ou illisible : 3.
INFORMATION_AGENT_COURT_REGISTRY_DAILY_CAP=3
# Invitation à déposer ses prochaines ventes, sur l'écran qui suit un dépôt volontaire (/contribuer),
# jamais dans l'email. Désactivée par défaut : affichée seulement avec la valeur exactement "true".
# Redéployer après modification.
NEXT_PUBLIC_INFORMATION_AGENT_PRO_INVITATION=
# Personne qui signe les demandes (« Prénom Nom, fonction »), au-dessus de « Pour l’équipe Immojudis ».
# Vide (valeur par défaut) : « L’équipe Immojudis ». Le brouillon reste modifiable avant l'envoi.
INFORMATION_AGENT_SIGNATURE_NAME=
COMMERCIAL_CONFIRMATION_CRON_LIMIT=25

# Optional listing integrations. Redeploy after changing any NEXT_PUBLIC_* variable.
# Restrict this public key to Maps Embed API and the site's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Server-only RapidAPI key, subscribed to Meteostat's free plan (hard quota).
# Apply 20261006120000_meteostat_monthly_cache.sql before enabling it.
METEOSTAT_RAPIDAPI_KEY=
# ClimaScore's communal widget needs no key. Shadowmap requires API access and
# its private integration documentation before an API endpoint can be configured.

# Suivi d'erreurs compatible Sentry (Sentry, GlitchTip, Bugsink...). Sans DSN, rien n'est envoyé.
# SENTRY_DSN : erreurs serveur ; NEXT_PUBLIC_SENTRY_DSN : erreurs navigateur (public par nature).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Clé de signature des liens de désinscription des emails d'alerte (optionnelle : à défaut,
# une clé est dérivée de SUPABASE_SERVICE_ROLE_KEY).
EMAIL_UNSUBSCRIBE_SECRET=

# Hôte de l'API DVF du Cerema (l'hôte « preprod » est l'API publique réellement servie).
CEREMA_DVF_BASE_URL=

# Ventes notariales et domaniales : filtres et pages d'entrée affichés par défaut.
# Mettre « false » uniquement pour les masquer (les annonces restent dans le catalogue).
NEXT_PUBLIC_NOTARY_STATE_PILOTS_ENABLED=true
