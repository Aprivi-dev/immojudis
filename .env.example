# Supabase (public, inlined at build time). The NEXT_PUBLIC_* names are canonical.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# DEPRECATED: VITE_SUPABASE_* are only read as a fallback of the NEXT_PUBLIC_* names (see
# src/lib/env.ts and next.config.ts). Leave them unset in a new environment; remove them from
# Vercel once the NEXT_PUBLIC_* variables are deployed.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin. SITE_URL is the canonical name; the aliases NEXT_PUBLIC_SITE_URL,
# NEXT_PUBLIC_APP_URL and APP_URL remain accepted as fallbacks; VERCEL_URL only outside production (src/lib/site-url.ts).
SITE_URL=http://localhost:3000

# Search-engine indexing switch. CLOSED unless the value is exactly "true": absent, empty or any
# other value sends `X-Robots-Tag: noindex, nofollow` on every response (src/proxy.ts) and a
# robots.txt without sitemap. Read on each request (not frozen at build). A Vercel preview or
# development deployment stays closed even with "true". Open it only on launch day, see
# docs/vercel_setup.md ("Indexation et référencement").
SEO_INDEXING_ENABLED=false
# The production smoke test (scripts/check-production-smoke.mjs) reads this same name to know which
# state to expect: keep the GitHub repository variable SEO_INDEXING_ENABLED equal to the Vercel one.

# Strict nonce-based CSP (P4-04). By default it is NOT sent: the historical CSP alone is enforced
# (the static pages carry no nonce, so a report-only strict policy flagged ~35 scripts per visit).
# false = enforce the strict policy (forces dynamic rendering of every page, no ISR / CDN cache).
CSP_REPORT_ONLY=true
# Preview the strict policy in report-only mode (via /api/csp-report) and the dynamic-rendering
# cost of nonces. Only with CSP_REPORT_ONLY=true.
CSP_NONCE_DYNAMIC=false
# Extra https origins allowed in frame-src (document viewer hosts), space separated.
CSP_FRAME_SRC_EXTRA=

# Administrator MFA (P0-02). Keep false until a TOTP factor is enrolled at /admin/securite, then set
# true here AND run `select app_private.set_admin_mfa_required(true);` in the database.
ADMIN_MFA_REQUIRED=false

# Mapbox powers interactive maps and static listing thumbnails.
# Example style: mapbox/streets-v12 or mapbox://styles/<user>/<style>
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12

# Test d'hébergement des photos principales (bucket public `sale-photos`, fonction `sale_photo_mirrors`).
# `on` : le site affiche notre copie de la photo, avec repli sur la source. Absent ou autre : photos
# des sources comme avant. Inlined at build time. Le pipeline a son propre interrupteur (PHOTO_MIRROR_ENABLED).
NEXT_PUBLIC_PHOTO_MIRROR=

# Server-side variables used only by trusted server routes/middleware.
# Do not expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=

# Server-side kill switch. Keep false until reviewed A/B snapshots are available.
TRIBUNAL_STATISTICS_ENABLED=false

# Server-side gate for the adjudication-price statistics and the auction scenarios shown on the sale
# page and on /tribunaux. Closed by default; set true only where the published data is meant to be shown.
ADJUDICATION_PRICE_STATISTICS_ENABLED=false
# Optional: pin the published adjudication-price build to display (UUID). Empty = the reviewed build published in the database.
ADJUDICATION_PRICE_STATISTICS_BUILD_ID=

# Opens the public page /prix-encheres-immobilieres (real adjudication prices, free access).
# Closed by default: 404, noindex, absent from sitemap.xml. It also requires
# ADJUDICATION_PRICE_STATISTICS_ENABLED=true above (cutting that one closes this page too), and
# each value must be exactly "true". Open it only with Licitor's written agreement and the legal
# review (see docs/vercel_setup.md, "Pages publiques de prix d'adjudication").
PUBLIC_ADJUDICATION_PRICES_ENABLED=false

# Server/worker-only StatJur network and persistence gate. Keep false until legal review.
JUSTICE_ACTIVITY_ENABLED=false

# Server/worker-only evaluation persistence gate. Never expose to browser code.
OUTCOME_EVALUATION_ENABLED=false

# Optional build cache, only on a filesystem without synchronization conflicts.
IMMOJUDIS_BUILD_CACHE=false
# Optional isolated output directory, relative to this project. Default: .next
IMMOJUDIS_NEXT_DIST_DIR=

# Optional: Stripe Billing for the Analyse subscription.
# Configure these in Vercel/server envs before activating paid checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Approved recurring Stripe Price for Analyse. Checkout stays disabled when empty.
STRIPE_ANALYSIS_PRICE_ID=
# Public copy for the approved local offer. Keep it aligned with the Stripe Price (29 EUR/month).
NEXT_PUBLIC_ANALYSIS_OFFER_LABEL="29 € / mois"

# Public legal identity. Required before enabling paid checkout and, by law, for any public site.
# Set REQUIRE_LEGAL_IDENTITY=true once these values exist: the production check then fails without them.
REQUIRE_LEGAL_IDENTITY=false
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ENTITY_FORM=
NEXT_PUBLIC_LEGAL_ENTITY_CAPITAL=
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_VAT_NUMBER=
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_MEDIATOR_NAME=
NEXT_PUBLIC_LEGAL_MEDIATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_MEDIATOR_WEBSITE=

# Optional: Vercel Cron security and smart-alert batch sizing.
# Vercel sends Authorization: Bearer $CRON_SECRET to configured cron routes. The same secret protects
# POST /api/pipeline/revalidate-sale (the pipeline expires the cache of a public sale with it).
CRON_SECRET=
SMART_ALERT_CRON_USER_LIMIT=25
SMART_ALERT_CRON_SALE_LIMIT=160
ALERT_NOTIFICATION_CRON_LIMIT=200
SALE_CHANGE_CRON_USER_LIMIT=25

# Date-only auction listings leave the public catalogue after the Paris civil day.
# Supported values: end_of_local_day (default) or start_of_day.
IMMOJUDIS_DATE_ONLY_CATALOGUE_POLICY=end_of_local_day

# Operational incidents use the existing GitHub Actions token by default.
# A dedicated HTTPS webhook takes precedence when configured.
GITHUB_SCROLL_TOKEN=
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=
OPERATIONS_ALERT_GITHUB_REPOSITORY=Aprivi-dev/immojudis
OPERATIONS_ALERT_GITHUB_WORKFLOW=operational-alert.yml
OPERATIONS_ALERT_GITHUB_REF=main
OPERATIONS_ALERT_DELIVERY_LIMIT=10

# Optional: Resend transactional email delivery for smart alerts and lawyer referrals.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
ALERT_EMAIL_FROM="Immojudis <alertes@immojudis.com>"
# P4-12: send information requests from a dedicated subdomain (for example
# "Assistant Immojudis <enquete@info.immojudis.com>"), distinct from transactional email, once its
# SPF/DKIM/DMARC are set up at the provider. Keep the sending switch below at false until a lawyer has
# validated the template; the footer needs NEXT_PUBLIC_LEGAL_ENTITY_NAME/ADDRESS and the portal secret.
INFORMATION_AGENT_EMAIL_FROM="Assistant Immojudis <assistant@immojudis.com>"

# Formulaire de contact (Resend). Destinataire : CONTACT_EMAIL_TO, à défaut NEXT_PUBLIC_LEGAL_CONTACT_EMAIL.
# Expéditeur : CONTACT_EMAIL_FROM, à défaut ALERT_EMAIL_FROM. Sans RESEND_API_KEY, le formulaire
# affiche qu'il est indisponible.
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
# Domaine de réception Resend, sans protocole (ex. reponses.immojudis.com).
INFORMATION_AGENT_INBOUND_DOMAIN=reponses.immojudis.com
# Secret aléatoire d'au moins 32 octets pour signer les liens privés de dépôt.
INFORMATION_AGENT_PORTAL_SECRET=
# Maintenir false jusqu'à autorisation explicite d'envoyer à de vrais contacts. Même à true, chaque
# e-mail reste déclenché à la main par un administrateur, fiche par fiche, après l'aperçu.
INFORMATION_AGENT_OUTBOUND_ENABLED=false
INFORMATION_AGENT_OUTBOUND_CANARY_ONLY=true
# Recherche automatique de l'adresse du professionnel (autre annonce, site du cabinet). Coupée sauf
# valeur exactement "true", et seulement sur https://immojudis.com. Ne l'activer qu'après les
# conditions du runbook (docs/runbooks/information-agent.md).
INFORMATION_AGENT_ADDRESS_SEARCH_ENABLED=false
COMMERCIAL_CONFIRMATION_CRON_LIMIT=25

# Optional listing integrations. Redeploy after changing any NEXT_PUBLIC_* variable.
# Restrict this public key to Maps Embed API and the site's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# Server-only RapidAPI key, subscribed to Meteostat's free plan (hard quota).
# Apply 20261006120000_meteostat_monthly_cache.sql before enabling it.
METEOSTAT_RAPIDAPI_KEY=
# ClimaScore's communal widget needs no key. Shadowmap requires API access and
# its private integration documentation before an API endpoint can be configured.

# Suivi d'erreurs compatible Sentry (Sentry, GlitchTip, Bugsink...). Sans DSN, rien n'est envoyé.
# SENTRY_DSN : erreurs serveur ; NEXT_PUBLIC_SENTRY_DSN : erreurs navigateur (public par nature).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Clé de signature des liens de désinscription des emails d'alerte (optionnelle : à défaut,
# une clé est dérivée de SUPABASE_SERVICE_ROLE_KEY).
EMAIL_UNSUBSCRIBE_SECRET=

# Hôte de l'API DVF du Cerema (l'hôte « preprod » est l'API publique réellement servie).
CEREMA_DVF_BASE_URL=

# Ventes notariales et domaniales : filtres et pages d'entrée affichés par défaut.
# Mettre « false » uniquement pour les masquer (les annonces restent dans le catalogue).
NEXT_PUBLIC_NOTARY_STATE_PILOTS_ENABLED=true
